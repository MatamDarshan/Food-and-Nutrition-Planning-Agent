# =====================================================================
# AI-Based Food and Nutrition Planning Agent — Environment Configuration
# =====================================================================

# Google Gemini API Key (Required for live Gemini 2.0 Flash reasoning)
# Obtain free from: https://aistudio.google.com/app/apikey
# Paste your API key below:
GOOGLE_API_KEY=

# Model Selection (Default: gemini-2.0-flash)
MODEL_NAME=gemini-2.0-flash

# Model Temperature (0.0 for deterministic, 0.2 for balanced reasoning)
TEMPERATURE=0.2

# Self-Healing Retry Guard (Maximum validation retries before fallback)
MAX_REVISIONS=2

# Calorie Deviation Acceptance Threshold (0.15 = +/- 15%)
CALORIE_DEVIATION_THRESHOLD=0.15
